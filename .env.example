# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Required in production (NODE_ENV=production, e.g. via Docker). The server
# refuses to start without it — a missing/default secret would let anyone
# forge valid login tokens. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://manugent:manugent_password@localhost:5432/manugent

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose provider: 'groq' (free, fast) or 'openai' (premium)
AI_PROVIDER=groq

# Groq API Key (free tier available) - https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API Key - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model to use (optional - defaults to llama3-8b-8192 for Groq, gpt-4o-mini for OpenAI)
# AI_MODEL=llama3-8b-8192
