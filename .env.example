# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# Required in production (NODE_ENV=production). The server refuses to start
# without it. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── Database (Supabase) ──────────────────────────────────────────────────────
# The server uses @supabase/supabase-js with these credentials.
# Find them in your Supabase project: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Frontend also reads these (Vite exposes VITE_ prefixed vars to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose provider: 'groq' (free, fast) or 'openai' (premium)
AI_PROVIDER=groq

# Groq API Key (free tier available) - https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API Key - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model to use (optional - defaults to llama3-8b-8192 for Groq, gpt-4o-mini for OpenAI)
# AI_MODEL=llama3-8b-8192
