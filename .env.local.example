# ── Ambiente local com Docker Compose ────────────────────────────────────────
# Copia este ficheiro para .env e ajusta conforme necessário.
#
# Para iniciar: docker compose up -d
# O servidor liga-se automaticamente ao PostgreSQL local (sem Supabase).

PORT=3000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=manugent-dev-secret-change-in-production
JWT_EXPIRES_IN=24h

# ── Base de dados local (Docker Compose) ────────────────────────────────────
# Quando SUPABASE_URL não está definido, o servidor usa DATABASE_URL via pg.
DATABASE_URL=postgres://manugent:manugent_password@localhost:5433/manugent

# Deixa em branco para usar Docker local:
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── IA (opcional) ─────────────────────────────────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
