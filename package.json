{
  "name": "manugent",
  "version": "2.0.0",
  "description": "ManuGent — Plataforma CMMS com Agente IA de Manutenção Industrial",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:api",
    "build:api": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "preview": "npm run build && node dist/server.js",
    "lint": "node_modules/.bin/tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "dotenv": "^16.6.1",
    "hono": "^4.12.23",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
